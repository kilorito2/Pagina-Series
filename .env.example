# Copiá este archivo a ".env" y completá los valores.
# Nunca subas el ".env" real a un repositorio.

# --- Base de datos --------------------------------------------------------
# PostgreSQL. Local con Docker: postgresql://postgres:postgres@localhost:5432/animeverse
# O un proveedor administrado (Neon, Supabase, Railway, Render).
#
# Con Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = "Transaction pooler" (puerto 6543, agregale ?pgbouncer=true)
# DIRECT_URL   = "Direct connection" o "Session pooler" (puerto 5432)
# Si tu Postgres no tiene pooler (Docker local, Railway, etc.), las dos
# variables pueden apuntar a la misma URL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/animeverse"
DIRECT_URL="postgresql://usuario:password@localhost:5432/animeverse"

# --- Auth.js (NextAuth) ----------------------------------------------------
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="reemplazar-por-un-secreto-de-32-caracteres-o-mas"
# Solo necesario en producción si el dominio no se detecta solo.
NEXTAUTH_URL="http://localhost:3000"

# Login con Google (opcional). Se obtienen en Google Cloud Console > OAuth.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Emails (verificación de cuenta, recuperar contraseña) ----------------
# Sin RESEND_API_KEY, lib/email.ts loguea el email por consola (útil en dev).
RESEND_API_KEY=""
EMAIL_FROM="AnimeVerse <no-reply@animeverse.app>"

# --- Almacenamiento de imágenes (Cloudflare R2, S3 compatible) ------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="animeverse-media"
R2_PUBLIC_URL="https://media.animeverse.app"

# --- Público (accesible en el cliente, prefijo obligatorio) ---------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# EMBEDS = FuenteVideo.url apunta a un iframe de un servidor externo.
# HLS    = FuenteVideo.url apunta a un archivo .m3u8 propio.
NEXT_PUBLIC_ORIGEN_VIDEO="EMBEDS"
